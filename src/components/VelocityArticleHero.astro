---
interface Props {
  article: any;
}
const { article } = Astro.props;
const fmt = new Intl.DateTimeFormat('fr-CA', { day: 'numeric', month: 'long', year: 'numeric' });
---

<header class="relative overflow-hidden border-b border-border bg-background-secondary pt-20 pb-12 md:pt-28 md:pb-16">
  <div class="bg-grid-pattern absolute inset-0 opacity-30 [mask-image:linear-gradient(to_bottom,white_50%,transparent)]"></div>
  <div class="absolute right-1/4 top-0 h-96 w-96 rounded-full bg-brand-200/20 blur-3xl dark:bg-brand-800/10"></div>

  <div class="relative mx-auto max-w-4xl px-6">
    <div class="mb-6 flex flex-wrap gap-2">
      {article.data.tags.map((tag: string) => (
        <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-200 dark:bg-brand-900/30 dark:text-brand-300 dark:ring-brand-800">
          {tag}
        </span>
      ))}
    </div>

    <h1 class="mb-6 font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl lg:text-6xl">
      {article.data.title}
    </h1>

    <p class="mb-8 max-w-3xl text-xl leading-relaxed text-foreground-muted">
      {article.data.description}
    </p>

    <div class="flex flex-wrap items-center gap-5 text-sm text-foreground-muted">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 text-sm font-bold text-white shadow-sm">
          N
        </div>
        <span class="font-semibold text-foreground">{article.data.author}</span>
      </div>
      <div class="hidden h-8 w-px bg-border md:block"></div>
      <time datetime={article.data.publishedAt.toISOString()}>{fmt.format(article.data.publishedAt)}</time>
      <div class="hidden h-8 w-px bg-border md:block"></div>
      <span>{article.data.categories.join(' · ')}</span>
    </div>
  </div>

  {article.data.imageUrl && (
    <div class="relative mx-auto mt-12 max-w-5xl px-6 -mb-28">
      <div class="overflow-hidden rounded-xl border border-border bg-background shadow-2xl">
        <img
          src={article.data.imageUrl}
          alt={article.data.imageAlt || article.data.title}
          class="aspect-video w-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  )}
</header>
