---
import VelocityBlogCard from './VelocityBlogCard.astro';

interface Props {
  title: string;
  description: string;
  articles: any[];
  categoryLinks?: { label: string; href: string; count: number }[];
}
const { title, description, articles, categoryLinks = [] } = Astro.props;
---

<section class="border-b border-border bg-background-secondary">
  <div class="container py-16 md:py-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">Archives</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight md:text-6xl">{title}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-foreground-muted">{description}</p>

    {categoryLinks.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {categoryLinks.map((category) => (
          <a
            href={category.href}
            class="rounded-full border border-border bg-background px-3 py-1.5 text-sm font-medium text-foreground-muted transition hover:border-border-strong hover:text-foreground"
          >
            {category.label} <span class="text-foreground-subtle">({category.count})</span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<section class="container py-12 md:py-16">
  {articles.length > 0 ? (
    <div class="grid gap-6 md:grid-cols-2">
      {articles.map((article, index) => (
        <VelocityBlogCard article={article} featured={index === 0} />
      ))}
    </div>
  ) : (
    <div class="rounded-xl border border-border bg-background-secondary p-8 text-foreground-muted">
      Aucun article dans cette section pour le moment.
    </div>
  )}
</section>
