---
interface Props {
  article: any;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const locale = article.data.lang === 'en-CA' ? 'en-CA' : 'fr-CA';
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const base = import.meta.env.BASE_URL;
const prefix = article.data.lang === 'en-CA' ? 'en-ca/' : '';
const articleHref = `${base}${prefix}${article.data.legacyUrl.replace(/^\//, '')}`;
---

<article class:list={[
  'group relative overflow-hidden rounded-xl border bg-background transition-all duration-200',
  featured
    ? 'border-brand-500/30 shadow-lg md:col-span-2'
    : 'border-border hover:-translate-y-0.5 hover:border-border-strong hover:shadow-md',
]}>
  <a href={articleHref} class:list={['block', featured && 'md:grid md:grid-cols-2']}>
    {article.data.imageUrl && (
      <div class="overflow-hidden bg-background-secondary">
        <img
          src={article.data.imageUrl}
          alt={article.data.imageAlt || article.data.title}
          class:list={[
            'w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]',
            featured ? 'h-full min-h-72' : 'aspect-video'
          ]}
          loading="lazy"
        />
      </div>
    )}

    <div class="p-6 md:p-8">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-foreground-subtle">
        <time datetime={article.data.publishedAt.toISOString()}>{fmt.format(article.data.publishedAt)}</time>
        <span>·</span>
        <span>{article.data.categories.join(' · ')}</span>
        {article.data.readingMinutes !== undefined && (
          <>
            <span>·</span>
            <span>{article.data.readingMinutes} {article.data.lang === 'en-CA' ? 'min read' : 'min de lecture'}</span>
          </>
        )}
        {article.data.legacyViews !== undefined && (
          <>
            <span>·</span>
            <span>{article.data.legacyViews} {article.data.lang === 'en-CA' ? 'legacy views' : 'vues héritées'}</span>
          </>
        )}
      </div>

      <h2 class:list={[
        'font-display font-bold tracking-tight text-foreground transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-400',
        featured ? 'text-3xl md:text-4xl' : 'text-2xl'
      ]}>
        {article.data.title}
      </h2>

      <p class="mt-4 leading-relaxed text-foreground-muted">
        {article.data.description}
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {article.data.tags.slice(0, 3).map((tag: string) => (
          <span class="rounded-full bg-background-secondary px-2.5 py-1 text-xs font-medium text-foreground-muted ring-1 ring-inset ring-border">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
