---
interface Props {
  lang: 'fr-CA' | 'en-CA';
}
const { lang } = Astro.props;
const isEnglish = lang === 'en-CA';
const title = isEnglish ? 'Search the site' : 'Rechercher sur le site';
const intro = isEnglish
  ? 'Search article titles and full content indexed at build time with Pagefind.'
  : 'Recherchez dans les titres et le contenu intégral des articles, indexés au build avec Pagefind.';
const placeholder = isEnglish ? 'Search articles…' : 'Rechercher dans les articles…';
const emptyLabel = isEnglish ? 'No results.' : 'Aucun résultat.';
const loadingLabel = isEnglish ? 'Searching…' : 'Recherche…';
---

<section class="container py-16 md:py-24">
  <div class="mx-auto max-w-4xl">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">
      Pagefind
    </p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-foreground-muted">{intro}</p>

    <form id="search-form" class="mt-10" role="search">
      <div class="flex gap-3">
        <input
          id="search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder={placeholder}
          class="min-w-0 flex-1 rounded-lg border border-border bg-background px-4 py-3 text-base text-foreground shadow-sm outline-none transition focus:border-border-strong focus:ring-2 focus:ring-ring/20"
        />
        <button
          type="submit"
          class="rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary-hover"
        >
          {isEnglish ? 'Search' : 'Rechercher'}
        </button>
      </div>
    </form>

    <div id="search-status" class="mt-6 text-sm text-foreground-muted" aria-live="polite"></div>
    <div id="search-results" class="mt-8 grid gap-4"></div>
  </div>
</section>

<script define:vars={{ lang, emptyLabel, loadingLabel }}>
  const input = document.getElementById('search-input');
  const form = document.getElementById('search-form');
  const status = document.getElementById('search-status');
  const resultsRoot = document.getElementById('search-results');

  let pagefind;

  const isExpectedLanguage = (url) => {
    if (lang === 'en-CA') return url.includes('/en-ca/');
    return !url.includes('/en-ca/');
  };

  const renderResult = (result) => {
    const article = document.createElement('article');
    article.className =
      'rounded-xl border border-border bg-background p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-border-strong hover:shadow-md';

    const link = document.createElement('a');
    link.href = result.url;
    link.className = 'block';

    const title = document.createElement('h2');
    title.className =
      'font-display text-2xl font-bold tracking-tight text-foreground transition-colors hover:text-brand-600 dark:hover:text-brand-400';
    title.textContent = result.meta?.title || result.url;

    const excerpt = document.createElement('p');
    excerpt.className = 'mt-3 leading-relaxed text-foreground-muted';
    excerpt.innerHTML = result.excerpt || '';

    const url = document.createElement('div');
    url.className = 'mt-4 text-xs font-medium text-foreground-subtle';
    url.textContent = result.url;

    link.append(title, excerpt, url);
    article.append(link);
    return article;
  };

  const search = async (query) => {
    const q = query.trim();
    resultsRoot.innerHTML = '';

    if (!q) {
      status.textContent = '';
      return;
    }

    status.textContent = loadingLabel;

    try {
      if (!pagefind) {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
      }

      const response = await pagefind.search(q);
      const data = await Promise.all(response.results.map((result) => result.data()));
      const filtered = data.filter((result) => isExpectedLanguage(result.url));

      status.textContent = filtered.length
        ? (lang === 'en-CA'
          ? `${filtered.length} result${filtered.length > 1 ? 's' : ''}`
          : `${filtered.length} résultat${filtered.length > 1 ? 's' : ''}`)
        : emptyLabel;

      for (const result of filtered) {
        resultsRoot.append(renderResult(result));
      }
    } catch (error) {
      console.error(error);
      status.textContent = lang === 'en-CA'
        ? 'Search index is not available yet.'
        : 'L’index de recherche n’est pas encore disponible.';
    }
  };

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  input.value = initialQuery;

  if (initialQuery) search(initialQuery);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input.value;
    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set('q', query.trim());
    else url.searchParams.delete('q');
    history.replaceState({}, '', url);
    search(query);
  });
</script>
