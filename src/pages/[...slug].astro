---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.data.legacyUrl.replace(/^\//,'').replace(/\/$/,'') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const fmt = new Intl.DateTimeFormat('fr-CA', { day:'numeric', month:'long', year:'numeric' });
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="article">
    <div class="eyebrow">{article.data.categories.join(' · ')}</div>
    <h1>{article.data.title}</h1>
    <div class="meta">{fmt.format(article.data.publishedAt)} · Par {article.data.author}</div>
    <p class="lead">{article.data.description}</p>

    {article.data.migrationStatus === 'sample' && (
      <div class="migration">
        <strong>POC de migration :</strong> cette page valide le slug, les métadonnées, le rendu Markdown et le lien vers l’OKF. Le corps est volontairement abrégé dans ce dry-run ; une migration réelle importerait le contenu WordPress intégral et les médias.
      </div>
    )}

    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
