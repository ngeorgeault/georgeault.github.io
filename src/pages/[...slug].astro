---
import BaseLayout from '../layouts/BaseLayout.astro';
import VelocityArticleHero from '../components/VelocityArticleHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => article.data.lang === 'fr-CA');
  return articles.map((article) => ({
    params: { slug: article.data.legacyUrl.replace(/^\//,'').replace(/\/$/,'') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL;
const alternateHref = `${base}en-ca/${article.data.legacyUrl.replace(/^\//,'')}`;
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.imageUrl}
  lang="fr-CA"
  alternateHref={alternateHref}
>
  <VelocityArticleHero article={article} />

  <article data-pagefind-body class:list={['py-12 md:py-16', article.data.imageUrl ? 'pt-20 md:pt-24' : '']}>
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-8 flex items-center gap-2 text-sm text-foreground-subtle">
        <a class="hover:text-foreground" href={base}>Accueil</a>
        <span>/</span>
        <span>Article</span>
      </div>

      <aside class="mb-10 rounded-xl border border-border bg-background-secondary p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400">Connaissance ≠ publication</p>
        <div class="mt-3 grid gap-3 text-sm md:grid-cols-2">
          <div>
            <span class="font-semibold text-foreground">Publication</span>
            <p class="mt-1 text-foreground-muted">Ce texte, sa langue, son titre, son image et son URL sont une représentation éditoriale.</p>
          </div>
          <div>
            <span class="font-semibold text-foreground">Source de connaissance</span>
            <p class="mt-1 font-mono text-xs text-foreground-muted">{article.data.okfSource}</p>
          </div>
        </div>
      </aside>

      <span class="sr-only" data-pagefind-meta="title">{article.data.title}</span>
      <span class="sr-only" data-pagefind-meta="image">{article.data.imageUrl || ''}</span>
      <div class="prose max-w-none text-lg">
        <Content />
      </div>

      {article.data.imageCredit && (
        <p class="mt-12 border-t border-border pt-6 text-xs text-foreground-subtle">
          {article.data.imageCredit}
        </p>
      )}

      <div class="mt-12 border-t border-border pt-8">
        <a class="font-semibold text-brand-600 hover:text-brand-500 dark:text-brand-400" href={base}>← Retour aux articles</a>
      </div>
    </div>
  </article>
</BaseLayout>
