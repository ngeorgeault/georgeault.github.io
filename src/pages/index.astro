---
import BaseLayout from '../layouts/BaseLayout.astro';
import VelocityBlogCard from '../components/VelocityBlogCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((article) => article.data.lang === 'fr-CA')
  .sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout
  title="Tales from the Scarf — Astro + OKF + Velocity"
  lang="fr-CA"
  alternateHref="/en-ca/"
>
  <section class="relative overflow-hidden border-b border-border bg-background-secondary">
    <div class="bg-grid-pattern absolute inset-0 opacity-30 [mask-image:linear-gradient(to_bottom,white_20%,transparent)]"></div>
    <div class="absolute -right-32 top-12 h-96 w-96 rounded-full bg-brand-200/30 blur-3xl dark:bg-brand-800/10"></div>
    <div class="container relative py-24 md:py-32">
      <div class="max-w-4xl">
        <div class="mb-5 inline-flex rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:border-brand-800 dark:bg-brand-900/20 dark:text-brand-300">
          Dry-run · Astro + OKF + Velocity
        </div>
        <h1 class="font-display text-5xl font-bold tracking-tight md:text-7xl">
          C’est bien plus que de la technologie…
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-foreground-muted md:text-xl">
          La publication est une représentation éditoriale. La connaissance réutilisable reste séparée dans OKF.
        </p>
      </div>
    </div>
  </section>

  <section id="articles" class="container py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600 dark:text-brand-400">Dernières publications</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">Les 20 articles les plus récents du blog</h2>
      <p class="mt-3 text-foreground-muted">
        Les métadonnées, dates, URL historiques et médias WordPress sont conservés côté publication ; les concepts réutilisables restent dans <code>knowledge/okf</code>.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {articles.map((article, index) => (
        <VelocityBlogCard article={article} featured={index === 0} />
      ))}
    </div>
  </section>
</BaseLayout>
